# =============================================================================
# Self-Hosted Langfuse Configuration for RAG Pipeline
# =============================================================================

# Langfuse Self-Hosted Configuration
# Get these keys from http://localhost:3000 after creating a project
LANGFUSE_PUBLIC_KEY="your-public-key-here"
LANGFUSE_SECRET_KEY="your-secret-key-here"

# Self-hosted endpoint
LANGFUSE_HOST=http://localhost:3000

# For Docker network compatibility
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# vLLM Configuration (Local LLM Server)
# =============================================================================

# vLLM server endpoint (OpenAI-compatible)
OPENAI_BASE_URL=http://localhost:8000/v1

# API key (vLLM doesn't require auth, any value works)
OPENAI_API_KEY=dummy

# =============================================================================
# Hugging Face Configuration (Optional - for downloading models)
# =============================================================================
# Get your token from: https://huggingface.co/settings/tokens
# HUGGING_FACE_HUB_TOKEN=hf_your_token_here
