# =============================================================================
# Self-Hosted Langfuse Configuration
# =============================================================================
# This configuration uses locally running Langfuse server
# Start with: docker-compose up -d

# Langfuse Self-Hosted Configuration
# After starting docker-compose, create a project and get these keys from http://localhost:3000
LANGFUSE_PUBLIC_KEY="pk-lf-your-public-key-here"
LANGFUSE_SECRET_KEY="sk-lf-your-secret-key-here"

# Self-hosted endpoint (local Langfuse server)
LANGFUSE_HOST=http://localhost:3000

# =============================================================================
# vLLM Configuration (Local LLM Server)
# =============================================================================
# vLLM runs locally via Docker and provides OpenAI-compatible API

# vLLM server endpoint (OpenAI-compatible)
OPENAI_BASE_URL=http://localhost:8000/v1

# API key (vLLM doesn't require auth, any value works)
OPENAI_API_KEY=dummy

# =============================================================================
# Hugging Face Configuration (Optional - for downloading models)
# =============================================================================
# Get your token from: https://huggingface.co/settings/tokens
# HUGGING_FACE_HUB_TOKEN=hf_your_token_here
